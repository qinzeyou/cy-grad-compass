{
  "name": "cy-grad-compass",
  "version": "0.1.0",
  "description": "毕业设计项目生成与管理工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "test": "npm run build && node --test \"dist-electron/database/*.test.js\" \"dist-electron/tests/*.test.js\" && vitest run",
    "test:ui": "vitest run",
    "seed": "npm run build && electron scripts/seed-demo-data.cjs",
    "smoke": "npm run build && electron scripts/smoke-check.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/icons-svg": "^4.5.0",
    "@vitejs/plugin-react": "latest",
    "antd": "^5.27.6",
    "electron": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "jsdom": "^29.1.1",
    "typescript": "latest",
    "vitest": "^4.1.11",
    "wait-on": "latest"
  }
}
